# JWT_SECRET is auto-generated on first start and persisted in /data/auth/jwt_secret
# Uncomment to override with a custom value
# JWT_SECRET=your-super-secret-jwt-key-change-in-production

JWT_EXPIRATION_HOURS=24

# Server port inside the container
PORT=8000

# Paths inside the vibe-manager container
DATA_ROOT=/data
FILEBROWSER_ROOT=/filebrowser
# Path on the host, used in generated compose volume mounts
FILEBROWSER_HOST=/data/filebrowser/files
STATIC_DIR=/app/static

# Log filter (RUST_LOG syntax), e.g. "debug" or "info,vibe_manager=debug"
# RUST_LOG=info,vibe_manager=debug
